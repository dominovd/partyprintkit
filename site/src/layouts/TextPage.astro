---
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { routes, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  heading: string;
  lede?: string;
  crumb: string;
  updated?: string;
  socialImage?: string;
}

const { title, description, path, eyebrow, heading, lede, crumb, updated, socialImage } =
  Astro.props;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: heading,
    url: site.origin + path,
    ...(updated ? { dateModified: updated } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.origin + '/' },
      { '@type': 'ListItem', position: 2, name: crumb, item: site.origin + path },
    ],
  },
];
---

<Base title={title} description={description} path={path} socialImage={socialImage} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumb trail={[routes.home]} current={crumb} />
  </div>

  <article class="wrap prose">
    <header class="prose__head">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h2">{heading}</h1>
      {lede && <p class="lede prose__lede">{lede}</p>}
      {updated && <p class="prose__updated">Last updated {updated}</p>}
    </header>
    <slot />
  </article>
</Base>

<style>
  .prose { max-width: 760px; padding: 26px 24px 90px; }
  .prose__head { margin-bottom: 34px; }
  .prose__lede { margin: 18px 0 0; }
  .prose__updated { font-size: 12px; color: var(--ink-soft); margin: 16px 0 0; }

  .prose :global(h2) {
    font-size: 24px;
    letter-spacing: -0.9px;
    margin: 42px 0 12px;
  }
  .prose :global(h3) { font-size: 18px; margin: 28px 0 8px; }
  .prose :global(p) { font-size: 15px; line-height: 1.65; color: var(--ink-soft); margin: 0 0 16px; }
  .prose :global(ul) { margin: 0 0 18px; padding-left: 20px; }
  .prose :global(li) { font-size: 15px; line-height: 1.65; color: var(--ink-soft); margin-bottom: 8px; }
  .prose :global(a) { color: var(--teal); font-weight: 600; }
  .prose :global(b), .prose :global(strong) { color: var(--ink); }
  .prose :global(.callout) {
    border: 1px solid var(--line);
    background: var(--paper-card);
    border-radius: var(--radius);
    padding: 20px 22px;
    margin: 26px 0;
  }
  .prose :global(.callout p:last-child) { margin-bottom: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 22px; font-size: 14px; }
  .prose :global(th), .prose :global(td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
  }
  .prose :global(th) { color: var(--ink); font-weight: 700; font-size: 12px; letter-spacing: 0.6px; text-transform: uppercase; }
</style>
