---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Link from '../components/Link.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import DownloadButton from '../components/DownloadButton.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { routes, site } from '../data/site';
import type { ShotId } from '../data/images';

const path = '/printables/';
const socialImage = '/social/birthday-kit-geometric-1000x1500.jpg';

type Card = { title: string; blurb: string; detail: string; shot: ShotId; route: typeof routes.banners };

const products: Card[] = [
  {
    title: 'Party banners',
    blurb: 'Letter flags on twine',
    detail: 'Thirteen true-size 5 × 7 in flags spelling HAPPY BIRTHDAY, in two designs.',
    shot: 'piece-banner',
    route: routes.banners,
  },
  {
    title: 'Banner letters',
    blurb: 'The full alphabet',
    detail: 'A to Z, 0 to 9 and punctuation, so a banner can say a name, an age or anything else.',
    shot: 'letters-alphabet-sheet',
    route: routes.bannerLetters,
  },
  {
    title: 'Party hats',
    blurb: 'Cut, roll, glue',
    detail: 'Two true-size cones per download, with the glue tab and cut line marked.',
    shot: 'piece-hat',
    route: routes.partyHats,
  },
];

const faq = [
  {
    q: 'Do the printables match each other?',
    a: 'Yes. Every piece is drawn in the same two designs with the same palette and the same 0.25 pt cut line, so a banner and a hat printed on the same afternoon look like one set.',
  },
  {
    q: 'Can I get everything in one file?',
    a: 'The complete birthday kit is one PDF: banner, hats, cupcake toppers, signs and favor tags, nineteen sheets in total.',
  },
  {
    q: 'What is coming next?',
    a: 'Cupcake toppers, party signs and favor tags as pages of their own, then further occasions. Each one appears here the day its files and photographs are finished, not before.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'All printables',
    url: site.origin + path,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.origin + '/' },
      { '@type': 'ListItem', position: 2, name: 'Printables', item: site.origin + path },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<Base
  title="All Free Printables: Party Banners, Letters and Hats"
  description="Every free printable on PartyPrintKit: party banner flags, the full banner alphabet and party hat templates. Print-ready PDFs for A4 and US Letter, no editor and no sign-up."
  path={path}
  socialImage={socialImage}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <Breadcrumb trail={[routes.home]} current="Printables" />
  </div>

  <section class="wrap head">
    <div>
      <p class="eyebrow">Everything ready to print</p>
      <h1 class="h1">All printables.</h1>
    </div>
    <p class="head__lede">
      Three finished printables so far, each drawn in the same two designs. More arrive one at a
      time, when the files and the photographs are both done.
    </p>
  </section>

  <section class="wrap grid">
    {
      products.map((product) => (
        <Link route={product.route} class="card">
          <div class="card__media">
            <Shot id={product.shot} sizes="(max-width: 900px) 92vw, 390px" />
          </div>
          <div class="card__body">
            <h2>{product.title}</h2>
            <p class="card__blurb">{product.blurb}</p>
            <p class="card__detail">{product.detail}</p>
          </div>
        </Link>
      ))
    }
  </section>

  <section class="kit">
    <div class="wrap kit__inner">
      <div>
        <p class="eyebrow kit__eyebrow">One download</p>
        <h2 class="h2">Or take the whole birthday kit.</h2>
        <p class="kit__lede">
          Banner, party hats, cupcake toppers, signs and favor tags in a single PDF: nineteen sheets
          in one style, for A4 or US Letter.
        </p>
        <div class="kit__actions">
          <DownloadButton href="/downloads/birthday-kit-geometric-a4.pdf" label="Download kit · A4 ↓" newTab />
          <DownloadButton href="/downloads/birthday-kit-geometric-letter.pdf" label="Kit · US Letter" variant="ghost" newTab />
        </div>
        <p class="kit__note">
          Not sure about paper or scaling? The <Link route={routes.printingGuide} class="text-link" label="printing guide" /> covers both.
        </p>
      </div>
      <div class="kit__photo">
        <Shot id="kit-sheets-flatlay-vertical" sizes="(max-width: 900px) 92vw, 340px" />
      </div>
    </div>
  </section>

  <FaqBlock eyebrow="Common questions" heading="About the printables." items={faq} />
</Base>

<style>
  .head { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 40px; align-items: end; padding: 20px 24px 34px; }
  .head__lede { font-size: 14px; line-height: 1.6; color: var(--ink-soft); margin: 0 0 6px; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; padding: 0 24px 80px; }
  .grid :global(.card__media) { aspect-ratio: 4 / 5; overflow: hidden; }
  .grid :global(.card__media img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .grid :global(.card__body) { padding: 18px 19px 22px; }
  .grid :global(.card__body h2) { font-size: 21px; letter-spacing: -0.7px; margin: 0 0 4px; }
  .card__blurb { font-size: 11px !important; font-weight: 700; letter-spacing: 0.7px; text-transform: uppercase; color: var(--teal) !important; margin: 0 0 10px !important; }
  .card__detail { font-size: 13px !important; line-height: 1.55; }

  .kit { background: var(--cream); padding: 76px 0; }
  .kit__inner { display: grid; grid-template-columns: 1fr 340px; gap: 70px; align-items: center; }
  .kit__eyebrow { color: var(--teal); }
  .kit__lede { font-size: 16px; line-height: 1.6; color: var(--ink-soft); margin: 18px 0 26px; max-width: 520px; }
  .kit__actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .kit__note { font-size: 12px; color: var(--ink-soft); margin: 18px 0 0; }
  .kit__photo { border-radius: 6px; overflow: hidden; box-shadow: var(--shadow-card); }
  .kit__photo :global(img) { width: 100%; display: block; }

  @media (max-width: 1000px) {
    .head, .kit__inner { grid-template-columns: 1fr; gap: 20px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
