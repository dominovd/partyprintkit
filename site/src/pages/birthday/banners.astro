---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Link from '../../components/Link.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DownloadButton from '../../components/DownloadButton.astro';
import TrustBar from '../../components/TrustBar.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { bannerDesigns, kitPieces } from '../../data/kits';
import { routes, site } from '../../data/site';
import { shots } from '../../data/images';
import { pinUrl } from '../../data/pin';

const path = '/birthday/banners/';
const releasedBannerDesigns = bannerDesigns.filter((design) => design.released);
const defaultDesign = releasedBannerDesigns[0];
const socialImage = defaultDesign.social;

const pinDescription =
  'Free printable happy birthday banner. Thirteen letter flags, PDF for A4 and US Letter, no sign-up.';
/** Pinterest pins the vertical sheet of the design on screen, not a fixed one. */
const pin = pinUrl({ path, media: socialImage, description: pinDescription });

const related = [
  {
    title: 'Printable banner letters',
    blurb: 'Full alphabet, numbers and punctuation',
    shot: 'letters-alphabet-sheet',
    route: routes.bannerLetters,
  },
  {
    title: 'Printable party hats',
    blurb: 'Two true-size cones in the same designs',
    shot: 'piece-hat',
    route: routes.partyHats,
  },
  {
    title: 'All printable banners',
    blurb: 'Every banner on the site in one place',
    shot: 'piece-banner',
    route: routes.banners,
  },
] as const;

const faq = [
  {
    q: 'What size is each banner flag?',
    a: 'Each finished pennant is roughly 5 × 7 inches when the PDF is printed at 100%.',
  },
  {
    q: 'Does it work with A4 and US Letter?',
    a: 'Yes. Separate print-ready PDFs are included for both paper formats, so nothing is scaled or cropped.',
  },
  {
    q: 'Can I change the banner wording?',
    a: 'Yes. Download the <a href="/banners/letters/">printable banner letters sheet</a> with the full alphabet, numbers and punctuation, and spell anything you need: HAPPY 40TH BIRTHDAY, a name, a nickname. Same paper, same cut lines, same hanging holes as this banner.',
  },
  {
    q: 'Is the download watermarked?',
    a: 'No. The small site credit sits outside the cut area and disappears once the flags are trimmed.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Free Printable Happy Birthday Banner',
    url: site.origin + path,
    primaryImageOfPage: {
      '@type': 'ImageObject',
      contentUrl: site.origin + socialImage,
      width: 1000,
      height: 1500,
      caption: 'Happy birthday printable banner sheet with thirteen letter flags',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.origin + '/' },
      { '@type': 'ListItem', position: 2, name: 'Banners', item: site.origin + '/banners/' },
      { '@type': 'ListItem', position: 3, name: 'Birthday', item: site.origin + path },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<Base
  title="Happy Birthday Banner Printable: Free PDF for A4 and US Letter"
  description="Free printable happy birthday banner in a coordinated geometric design. Thirteen letter flags, print-ready PDF for A4 and US Letter plus a 1000×1500 PNG. No editor, no sign-up, no watermark."
  path={path}
  socialImage={socialImage}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <Breadcrumb trail={[routes.home, routes.banners]} current="Birthday" />
  </div>

  <!-- One radio set drives the gallery, the download panel and the kit block,
       so a design choice never leaves a button pointing at another design. -->
  <div class="design-scope">
    {
      releasedBannerDesigns.map((design, i) => (
        <input
          class="picker__radio"
          type="radio"
          name="design"
          id={`design-${design.id}`}
          checked={i === 0}
        />
      ))
    }

  <section class="wrap picker">

    <div class="head">
      <div>
        <p class="eyebrow">Free birthday party printables</p>
        <h1 class="h1">Free Printable Happy Birthday Banner</h1>
      </div>
      <p class="head__lede">
        Print, cut and hang a complete birthday banner today. Two ready-made designs of the same
        printable happy birthday banner, no editor and no account required.
      </p>
    </div>

    <div class="stage">
      <div class="stage__main">
        {
          releasedBannerDesigns.map((design) => (
            <figure class="pane" data-design={design.id}>
              <Shot id={design.hung} loading="eager" sizes="(max-width: 1000px) 92vw, 640px" />
              <figcaption class="stage__badge">Design · {design.name}</figcaption>
            </figure>
          ))
        }
      </div>

      <!-- One selection model on the page: these thumbnails are the design
           chooser. No second switcher in the panel. -->
      <div class="thumbs" role="group" aria-label="Choose a design">
        {
          releasedBannerDesigns.map((design) => (
            <label class="thumb" for={`design-${design.id}`} data-design={design.id}>
              <span class="thumb__img">
                <Shot id={design.hung} sizes="220px" />
              </span>
              <span class="thumb__name">{design.name}</span>
            </label>
          ))
        }
      </div>

      <p class="stage__caption">
        Two designs of the same free printable happy birthday banner: botanical and geometric.
        Thirteen true-size letter flags per set, matched by the full alphabet sheet.
      </p>
    </div>

    <aside class="panel">
      <p class="panel__flag">Free instant download</p>

      {
        releasedBannerDesigns.map((design) => (
          <div class="pane panel__body" data-design={design.id}>
            <h2 class="panel__title">{design.title}</h2>
            <p class="panel__sub">
              Thirteen individual letter flags spelling HAPPY BIRTHDAY, ready to print on A4 or US
              Letter paper. The banner only: the rest of the kit is a separate download.
            </p>

            <figure class="sheet">
              <Shot id={design.sheet} sizes="(max-width: 1000px) 60vw, 240px" />
              <figcaption>The sheet you print · 1000 × 1500</figcaption>
            </figure>

            <p class="panel__label">Files included</p>
            <div class="pills">
              <span>PDF · A4 · 13 pages</span><span>PDF · US Letter</span><span>PNG · 1000×1500</span>
            </div>

            <div class="panel__buttons">
              <DownloadButton href={design.bannerA4} label="Download PDF · A4" newTab />
              <DownloadButton href={design.bannerLetter} label="PDF · US Letter" variant="ghost" newTab />
              <DownloadButton href={design.png} label="Download PNG" variant="ghost" />
              <a
                class="button button--teal"
                href={pinUrl({ path, media: design.social, description: pinDescription })}
                target="_blank"
                rel="noopener">Save to Pinterest</a>
            </div>
          </div>
        ))
      }

      <p class="panel__note">No sign-up · no watermark · personal use</p>
      <p class="panel__note panel__note--small">
        Print from the PDF, not from this page: the PDF holds the real paper size.
      </p>
    </aside>
  </section>

  <TrustBar
    headline="A real banner, from printer to party."
    items={['Download instantly', 'Print at home', 'Cut on dashed lines', 'String and hang']}
    icons={['↓', '⌂', '✂', '○']}
  />

  <!-- the rest of the kit -->
  <section class="wrap kit">
    <div class="kit__media">
      <div class="kit__photo kit__photo--a"><Shot id="piece-hat" sizes="(max-width: 900px) 45vw, 280px" /></div>
      <div class="kit__photo kit__photo--b"><Shot id="piece-topper" sizes="(max-width: 900px) 45vw, 280px" /></div>
    </div>
    <div>
      <p class="eyebrow">The rest of the birthday kit</p>
      <h2 class="h2">One banner is good.<br />The whole look is better.</h2>
      <p class="lede kit__lede">
        This birthday banner printable belongs to a complete coordinated kit. Download every matching
        piece in one PDF, or take only what your party needs.
      </p>
      <div class="kit__grid">
        {
          kitPieces.map((piece) => (
            <div class="kit__card">
              <b>{piece.title}</b>
              <span>{piece.blurb}</span>
            </div>
          ))
        }
      </div>
      {
        releasedBannerDesigns.map((design) => (
          <div class="pane button-row" data-design={design.id}>
            <DownloadButton href={design.kitA4} label="Complete kit · A4 →" newTab />
            <DownloadButton href={design.kitLetter} label="Complete kit · US Letter" variant="ghost" newTab />
          </div>
        ))
      }
    </div>
  </section>
  </div>

  <!-- printing and assembly: the part no AI Overview reproduces -->
  <section class="printing">
    <div class="wrap printing__inner">
      <div>
        <p class="eyebrow printing__eyebrow">Printing &amp; assembly</p>
        <h2 class="h2">From PDF to party wall.</h2>
        <p class="printing__sub">
          How to print a happy birthday banner printable at home, from paper weight to hanging.
        </p>
      </div>
      <div class="printing__cols">
        <div>
          <p><b>Paper.</b> Use regular 90–120 gsm paper for a lightweight banner, or matte 160–200 gsm cardstock when you want sturdier flags. Select “Actual size” or 100% in the print dialog so the pieces stay consistent.</p>
          <p><b>Cutting.</b> Cut along the dashed 0.25 pt outline with scissors or a craft knife and ruler. Keep the small top margin on each flag: it holds the hanging holes.</p>
        </div>
        <div>
          <p><b>Assembly.</b> Punch two holes near the marked top corners and thread cotton string or narrow ribbon through the back. Leave a small gap between letters so the message curves naturally when hung.</p>
          <p><b>Ink.</b> These designs avoid full-page color fills, so they stay practical on a home inkjet. Print one test page before sending the complete thirteen-letter set.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- other occasions -->
  <section class="wrap block">
    <div class="section-head">
      <div>
        <p class="eyebrow">More printable banners</p>
        <h2 class="h3">Keep a celebration ready.</h2>
      </div>
      <Link route={routes.banners} class="text-link" label="Browse all banners →" />
    </div>
    <div class="related">
      {
        related.map((item) => (
          <Link route={item.route} class="card">
            <div class="related__media">
              <Shot id={item.shot} sizes="(max-width: 900px) 92vw, 400px" />
            </div>
            <div class="card__body">
              <h3>{item.title}</h3>
              <p>{item.blurb}</p>
            </div>
          </Link>
        ))
      }
    </div>
  </section>

  <FaqBlock eyebrow="Common questions" heading="Before you download." items={faq} />
</Base>

<style>
  .picker { display: grid; grid-template-columns: 1fr 360px; gap: 34px 30px; padding: 8px 24px 60px; align-items: start; }
  .picker__radio { position: absolute; opacity: 0; pointer-events: none; }
  .head { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 40px; align-items: end; margin-bottom: 6px; }
  .head__lede { font-size: 13px; line-height: 1.55; color: var(--ink-soft); margin: 0 0 6px; }

  /* every design pane ships in the DOM; CSS decides which one is visible */
  .pane { display: none; margin: 0; }
  .design-scope :global(#design-botanical:checked) ~ .picker [data-design='botanical'],
  .design-scope :global(#design-botanical:checked) ~ .kit [data-design='botanical'],
  .design-scope :global(#design-geometric:checked) ~ .picker [data-design='geometric'],
  .design-scope :global(#design-geometric:checked) ~ .kit [data-design='geometric'],
  .design-scope :global(#design-minimal:checked) ~ .picker [data-design='minimal'],
  .design-scope :global(#design-minimal:checked) ~ .kit [data-design='minimal'] { display: block; }
  .pane.button-row { display: none; }
  .design-scope :global(#design-botanical:checked) ~ .kit .button-row[data-design='botanical'],
  .design-scope :global(#design-geometric:checked) ~ .kit .button-row[data-design='geometric'],
  .design-scope :global(#design-minimal:checked) ~ .kit .button-row[data-design='minimal'] { display: flex; }

  .stage__main { position: relative; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-soft); }
  .stage__main .pane { position: relative; aspect-ratio: 4 / 3; }
  .stage__main :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .stage__badge { position: absolute; left: 16px; top: 16px; background: var(--paper); border-radius: 99px; padding: 8px 13px; font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--ink); box-shadow: 0 4px 18px rgba(31, 47, 45, 0.15); }

  .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 14px; }
  .thumb { display: block; cursor: pointer; border: 2px solid transparent; border-radius: 6px; padding: 3px; }
  .thumb__img { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 4px; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumb :global(.shot-missing) { height: 100%; }
  .thumb__name { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: var(--ink-soft); margin-top: 7px; }
  .design-scope :global(#design-botanical:checked) ~ .picker .thumb[data-design='botanical'],
  .design-scope :global(#design-geometric:checked) ~ .picker .thumb[data-design='geometric'],
  .design-scope :global(#design-minimal:checked) ~ .picker .thumb[data-design='minimal'] { border-color: var(--coral); }
  .design-scope :global(#design-botanical:checked) ~ .picker .thumb[data-design='botanical'] .thumb__name,
  .design-scope :global(#design-geometric:checked) ~ .picker .thumb[data-design='geometric'] .thumb__name,
  .design-scope :global(#design-minimal:checked) ~ .picker .thumb[data-design='minimal'] .thumb__name { color: var(--ink); }

  .stage__caption { font-size: 12px; line-height: 1.55; color: var(--ink-soft); margin: 16px 0 0; max-width: 620px; }

  .panel { border: 1px solid var(--line); background: var(--paper-card); border-radius: var(--radius); padding: 24px 24px 22px; box-shadow: var(--shadow-soft); }
  .panel__flag { display: inline-block; background: #e4f1ee; color: var(--teal); border-radius: 99px; padding: 7px 12px; font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
  .panel__title { font-size: 27px; letter-spacing: -1.1px; line-height: 1.08; margin: 0 0 8px; }
  .panel__sub { font-size: 12px; color: var(--ink-soft); margin: 0 0 18px; line-height: 1.5; }
  .sheet { margin: 0 0 18px; }
  .sheet :global(img) { display: block; width: 100%; border-radius: 5px; box-shadow: var(--shadow-soft); }
  .sheet figcaption { font-size: 10px; letter-spacing: 0.8px; text-transform: uppercase; color: var(--ink-soft); margin-top: 8px; font-weight: 700; }
  .panel__label { font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-soft); font-weight: 700; margin: 0 0 9px; }
  .pills { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 18px; }
  .pills span { border: 1px solid var(--line); border-radius: 99px; padding: 6px 10px; font-size: 10px; font-weight: 700; color: var(--ink-soft); }
  .panel__buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
  .panel__buttons :global(.button) { justify-content: center; text-align: center; font-size: 12px; padding: 13px 10px; }
  .panel__note { text-align: center; font-size: 11px; color: var(--ink-soft); margin: 14px 0 0; }
  .panel__note--small { font-size: 10px; margin-top: 6px; }

  .kit { display: grid; grid-template-columns: 43% 57%; gap: 70px; align-items: center; padding: 80px 24px; }
  .kit__media { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: center; }
  .kit__photo { border-radius: 6px; overflow: hidden; box-shadow: var(--shadow-card); aspect-ratio: 4 / 5; }
  .kit__photo--a { transform: translateY(-14px); }
  .kit__photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .kit__lede { margin: 0 0 24px; max-width: 520px; font-size: 16px; }
  .kit__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 26px; }
  .kit :global(.kit__card) { border: 1px solid var(--line); border-radius: 6px; padding: 13px 15px; background: var(--paper-card); text-decoration: none; color: inherit; display: block; }
  .kit :global(.kit__card b) { display: block; font-size: 13px; margin-bottom: 3px; }
  .kit :global(.kit__card span) { font-size: 11px; color: var(--ink-soft); }
  .button-row { display: flex; flex-wrap: wrap; gap: 10px; }

  .printing { background: var(--teal-deep); color: #fff; padding: 74px 0; }
  .printing__inner { display: grid; grid-template-columns: 34% 66%; gap: 50px; }
  .printing__eyebrow { color: var(--mint); }
  .printing__sub { font-size: 13px; line-height: 1.55; color: #cde3df; margin: 16px 0 0; max-width: 320px; }
  .printing__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .printing__cols p { font-size: 13px; line-height: 1.6; color: #d1e6e2; margin: 0 0 18px; }
  .printing__cols b { color: #fff; }

  .block { padding: 80px 24px; }
  .related { display: grid; grid-template-columns: repeat(3, 1fr); gap: 17px; }
  .related__media { aspect-ratio: 4 / 3; overflow: hidden; }
  .related__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 1000px) {
    .picker { grid-template-columns: 1fr; }
    .head { grid-template-columns: 1fr; gap: 16px; align-items: start; }
    .kit, .printing__inner { grid-template-columns: 1fr; gap: 34px; }
    .related { grid-template-columns: 1fr; }
    .printing__cols { grid-template-columns: 1fr; gap: 0; }
  }
</style>
