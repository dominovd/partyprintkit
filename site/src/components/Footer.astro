---
import Link from './Link.astro';
import { footerColumns, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div>
        <div class="site-footer__brand">Party<i>Print</i>Kit</div>
        <p class="site-footer__about">{site.blurb}</p>
      </div>
      {
        footerColumns.map((col) => (
          <div class="site-footer__col">
            <b>{col.title}</b>
            {col.links.map((route) => <Link route={route} />)}
          </div>
        ))
      }
    </div>
    <div class="site-footer__bottom">
      <span>&copy; {year} PartyPrintKit.com</span>
      <span>{site.tagline}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--teal-ink); color: #e7f1ed; padding: 58px 0 28px; margin-top: 0; }
  .site-footer__top { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 60px; padding-bottom: 46px; border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .site-footer__brand { font-family: var(--font-display); font-weight: 700; font-size: 28px; margin-bottom: 13px; }
  .site-footer__brand i { font-style: normal; color: #f08a72; }
  .site-footer__about { font-size: 13px; line-height: 1.55; color: #c7d8d5; max-width: 290px; margin: 0; }
  .site-footer__col b { display: block; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: #90c8c3; margin-bottom: 17px; font-weight: 700; }
  .site-footer__col :global(a),
  .site-footer__col :global(span) { display: block; color: #e7f1ed; text-decoration: none; font-size: 13px; margin: 10px 0; }
  .site-footer__col :global(.link-pending) { color: #9fb8b4; border-bottom: 0; }
  .site-footer__bottom { display: flex; justify-content: space-between; padding-top: 24px; font-size: 11px; color: #aec7c3; gap: 16px; flex-wrap: wrap; }
  @media (max-width: 900px) { .site-footer__top { grid-template-columns: 1fr 1fr; gap: 32px; } }
</style>
